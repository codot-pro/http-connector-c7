{
   "$schema": "https://unpkg.com/@camunda/element-templates-json-schema/resources/schema.json",
   "name": "http-connector",
   "id": "com.codot.camundaconnectors.http.c7",
   "description": "CODOT HTTP Connector (v2.3.0)",
   "version": 1,
   "entriesVisible": false,
   "appliesTo": [
      "bpmn:ServiceTask"
   ],
   "elementType": {
      "value": "bpmn:ServiceTask"
   },
   "groups": [
      {
         "id": "inputs",
         "label": "Input Mapping"
      },
      {
         "id": "output",
         "label": "Output Mapping"
      },
      {
         "id": "debug",
         "label": "Debug tools"
      },
      {
         "id": "async",
         "label": "Asynchronous continuations"
      },
      {
         "id": "tls",
         "label": "TLS - Settings"
      }
   ],
   "properties": [
      {
         "label": "Implementation Type",
         "type": "Hidden",
         "value": "com.codot.camundaconnectors.http.HttpFunction",
         "editable": false,
         "binding": {
            "type": "property",
            "name": "camunda:class"
         }
      },
      {
         "label": "Method",
         "type": "Dropdown",
         "value": "GET",
         "choices": [
            {
               "name": "POST",
               "value": "POST"
            },
            {
               "name": "GET",
               "value": "GET"
            },
            {
               "name": "DELETE",
               "value": "DELETE"
            },
            {
               "name": "PATCH",
               "value": "PATCH"
            },
            {
               "name": "PUT",
               "value": "PUT"
            }
         ],
         "binding": {
            "type": "camunda:inputParameter",
            "name": "method"
         },
         "constraints": {
            "notEmpty": true
         },
         "group": "inputs"
      },
      {
         "label": "URL",
         "type": "String",
         "feel": "required",
         "binding": {
            "type": "camunda:inputParameter",
            "name": "url"
         },
         "constraints": {
            "notEmpty": true
         },
         "group": "inputs"
      },
      {
         "label": "Headers",
         "type": "Text",
         "feel": "required",
         "value": "{\"Content-Type\":\"application/json\"}",
         "binding": {
            "type": "camunda:inputParameter",
            "name": "headers"
         },
         "group": "inputs"
      },
      {
         "label": "Timeout",
         "type": "String",
         "feel": "required",
         "value": "60000",
         "binding": {
            "type": "camunda:inputParameter",
            "name": "timeout"
         },
         "constraints": {
            "notEmpty": true
         },
         "group": "inputs"
      },
      {
         "label": "Payload",
         "type": "Text",
         "feel": "required",
         "binding": {
            "type": "camunda:inputParameter",
            "name": "payload"
         },
         "group": "inputs"
      },
      {
         "label": "Response file name",
         "type": "String",
         "feel": "required",
         "binding": {
            "type": "camunda:inputParameter",
            "name": "response_file_name"
         },
         "constraints": {
            "notEmpty": true
         },
         "group": "inputs"
      },
      {
         "label": "Attach file",
         "type": "String",
         "value": "",
         "feel": "required",
         "binding": {
            "type": "camunda:inputParameter",
            "name": "attachment"
         },
         "group": "inputs"
      },
      {
         "label": "Delete attached file?",
         "binding": {
            "type": "camunda:inputParameter",
            "name": "delete"
         },
         "value": "false",
         "type": "Dropdown",
         "choices": [
            {
               "name": "TRUE",
               "value": "true"
            },
            {
               "name": "FALSE",
               "value": "false"
            }
         ],
         "group": "inputs"
      },
      {
         "label": "status code",
         "description": "Name of variable to store the response in",
         "group": "output",
         "type": "String",
         "value": "status_code",
         "constraints": {
            "notEmpty": true
         },
         "binding": {
            "type": "camunda:outputParameter",
            "source": "${status_code}"
         }
      },
      {
         "label": "status massage",
         "description": "Name of variable to store the response in",
         "group": "output",
         "type": "String",
         "value": "status_msg",
         "constraints": {
            "notEmpty": true
         },
         "binding": {
            "type": "camunda:outputParameter",
            "source": "${status_msg}"
         }
      },
      {
         "label": "response body",
         "description": "Name of variable to store the response in",
         "group": "output",
         "type": "String",
         "value": "response_body",
         "constraints": {
            "notEmpty": true
         },
         "binding": {
            "type": "camunda:outputParameter",
            "source": "${response_body}"
         }
      },
      {
         "label": "response headers",
         "description": "Name of variable to store the response in",
         "group": "output",
         "type": "String",
         "value": "response_headers",
         "constraints": {
            "notEmpty": true
         },
         "binding": {
            "type": "camunda:outputParameter",
            "source": "${response_headers}"
         }
      },
      {
         "label": "response file path",
         "description": "Name of variable to store the response in",
         "group": "output",
         "type": "String",
         "value": "response_file_path",
         "constraints": {
            "notEmpty": true
         },
         "binding": {
            "type": "camunda:outputParameter",
            "source": "${response_file_path}"
         }
      },
      {
         "label": "Debug mode",
         "feel": "required",
         "binding": {
            "type": "camunda:inputParameter",
            "name": "debugMode"
         },
         "value": "false",
         "constraints": {
            "notEmpty": true
         },
         "type": "Dropdown",
         "choices": [
            {
               "name": "TRUE",
               "value": "true"
            },
            {
               "name": "FALSE",
               "value": "false"
            }
         ],
         "group": "debug"
      },
      {
         "label": "Validate SSL",
         "feel": "required",
         "binding": {
            "type": "camunda:inputParameter",
            "name": "validateSSL"
         },
         "value": "true",
         "constraints": {
            "notEmpty": true
         },
         "type": "Dropdown",
         "choices": [
            {
               "name": "enabled",
               "value": "true"
            },
            {
               "name": "disabled",
               "value": "false"
            }
         ],
         "group": "tls"
      },
      {
         "label": "Trusted Store type",
         "feel": "required",
         "binding": {
            "type": "camunda:inputParameter",
            "name": "trustedStoreType"
         },
         "value": "JKS",
         "constraints": {
            "notEmpty": true
         },
         "type": "Dropdown",
         "choices": [
            {
               "name": "PKCS12",
               "value": "PKCS12"
            },
            {
               "name": "JKS",
               "value": "JKS"
            }
         ],
         "group": "tls"
      },
      {
         "label": "Trusted Store path",
         "type": "String",
         "feel": "required",
         "binding": {
            "type": "camunda:inputParameter",
            "name": "trustedStorePath"
         },
         "group": "tls"
      },
      {
         "label": "Trusted Store password",
         "type": "String",
         "feel": "required",
         "binding": {
            "type": "camunda:inputParameter",
            "name": "trustedStorePass"
         },
         "group": "tls"
      },
      {
         "label": "Enable Two-way SSL",
         "feel": "required",
         "binding": {
            "type": "camunda:inputParameter",
            "name": "is2WaySsl"
         },
         "value": "false",
         "constraints": {
            "notEmpty": true
         },
         "type": "Dropdown",
         "choices": [
            {
               "name": "enabled",
               "value": "true"
            },
            {
               "name": "disabled",
               "value": "false"
            }
         ],
         "group": "tls"
      },
      {
         "label": "Key Store type",
         "feel": "required",
         "binding": {
            "type": "camunda:inputParameter",
            "name": "keyStoreType"
         },
         "value": "PKCS12",
         "constraints": {
            "notEmpty": true
         },
         "type": "Dropdown",
         "choices": [
            {
               "name": "PKCS12",
               "value": "PKCS12"
            },
            {
               "name": "JKS",
               "value": "JKS"
            }
         ],
         "group": "tls"
      },
      {
         "label": "Key Store path",
         "type": "String",
         "feel": "required",
         "binding": {
            "type": "camunda:inputParameter",
            "name": "keyStorePath"
         },
         "group": "tls"
      },
      {
         "label": "Key Store password",
         "type": "String",
         "feel": "required",
         "binding": {
            "type": "camunda:inputParameter",
            "name": "keyStorePass"
         },
         "group": "tls"
      },
      {
         "label": "Async before?",
         "binding": {
            "type": "property",
            "name": "camunda:asyncBefore"
         },
         "type": "Boolean",
         "value": false,
         "group": "async"
      },
      {
         "label": "Async after?",
         "binding": {
            "type": "property",
            "name": "camunda:asyncAfter"
         },
         "type": "Boolean",
         "value": false,
         "group": "async"
      },
      {
         "label": "Async exclusive?",
         "binding": {
            "type": "property",
            "name": "camunda:exclusive"
         },
         "type": "Boolean",
         "value": true,
         "group": "async"
      }
   ]
}