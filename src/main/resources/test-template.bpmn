    <bpmn:serviceTask id="Activity_09of4td" name="MG" camunda:modelerTemplate="pro.codot.connectors.c7-modern-http-connector-v3.0.1" camunda:modelerTemplateVersion="1" camunda:class="pro.codot.connectors.delegates.HttpConnectorDelegate">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="timeout">5000</camunda:inputParameter>
          <camunda:inputParameter name="debugMode">true</camunda:inputParameter>
          <camunda:inputParameter name="responseFileName">xlsx.xlsx</camunda:inputParameter>
          <camunda:inputParameter name="tlsType">2waySsl</camunda:inputParameter>
          <camunda:inputParameter name="tlsSettings">{
   "keyStore": {
      "type": "PKCS12",
      "path": "/usr/local/share/ca-certificates/mg-personal.pfx",
      "password": "123123"
   }
}</camunda:inputParameter>
          <camunda:inputParameter name="url">https://tmgs.mgprofix.com/swws/swws.asmx</camunda:inputParameter>
          <camunda:inputParameter name="method">POST</camunda:inputParameter>
          <camunda:inputParameter name="headers">{"Content-Type":"text/xml; charset=utf-8"}</camunda:inputParameter>
          <camunda:inputParameter name="payload">&lt;soap:Envelope xmlns:soap="http://www.w3.org/2003/05/soap-envelope" xmlns:web="http://sb.com.ua/webservices/"&gt;
    &lt;soap:Header/&gt;
    &lt;soap:Body&gt;
        &lt;web:ExecOperation&gt;
            &lt;web:method&gt;OperationsSummary&lt;/web:method&gt;
            &lt;web:args&gt;
                &lt;web:SystemId&gt;mg&lt;/web:SystemId&gt;
                &lt;web:Language&gt;en&lt;/web:Language&gt;
                &lt;web:LoginType&gt;1&lt;/web:LoginType&gt;
                &lt;web:PointCode&gt;40298021&lt;/web:PointCode&gt;
                &lt;web:UserLogin&gt;report_main&lt;/web:UserLogin&gt;
                &lt;web:UserPassword&gt;123123&lt;/web:UserPassword&gt;
                &lt;web:Args&gt;
                    &lt;web:Field&gt;
                        &lt;web:Name&gt;requestJSON&lt;/web:Name&gt;
                        &lt;web:Value&gt;${getDataPayload}&lt;/web:Value&gt;
                    &lt;/web:Field&gt;
                &lt;/web:Args&gt;
            &lt;/web:args&gt;
        &lt;/web:ExecOperation&gt;
    &lt;/soap:Body&gt;
&lt;/soap:Envelope&gt;</camunda:inputParameter>
          <camunda:inputParameter name="saveAsFile">false</camunda:inputParameter>
          <camunda:outputParameter name="outputStatusCode">${outputStatusCode}</camunda:outputParameter>
          <camunda:outputParameter name="outputResponseType">${outputResponseType}</camunda:outputParameter>
          <camunda:outputParameter name="outputResponse">${outputResponse}</camunda:outputParameter>
          <camunda:outputParameter name="outputHeaders">${outputHeaders}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_14zs1yw</bpmn:incoming>
      <bpmn:outgoing>Flow_1lialjv</bpmn:outgoing>
    </bpmn:serviceTask>
